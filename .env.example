# Domínio canônico final (sem barra ou caminho). Ative indexação só em produção.
SITE_URL=http://localhost:3000
SITE_INDEXABLE=false

# Chave do cliente PHP Bartenders (servidor apenas)
SGC_KEY=
SGC_API_URL=https://sgc.tbrweb.com.br
NEXT_IS_SSR_ENABLED=
NEXT_SSR_HEADER=
NEXT_SSR_ORIGIN=

# Hosts HTTPS das imagens do cliente no SGC, separados por vírgula (sem protocolo)
SGC_IMAGE_HOSTS=
